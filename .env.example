# Скопируйте этот файл в .env.local и заполните, когда будете подключать базу.
# Без этих переменных приложение работает в демо-режиме: данные хранятся в браузере.

# PostgreSQL: Neon, Supabase, Timeweb Cloud, Yandex Cloud или локальная база
DATABASE_URL="postgres://user:password@localhost:5432/nexora"

# Ключ шифрования токенов интеграций (Telegram-бот, вебхуки). 32+ случайных символа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_ENCRYPTION_KEY=""

# Платёжный провайдер (Stripe / ЮKassa / CloudPayments) — подключается на следующем этапе
PAYMENTS_SECRET_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
